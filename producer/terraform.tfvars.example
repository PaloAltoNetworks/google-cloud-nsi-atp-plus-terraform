# ------------------------------------------------
# Required
# ------------------------------------------------

project_id      = ""
mgmt_allow_ips  = ["0.0.0.0/0"]
mgmt_public_ip  = true
region          = "us-west1"
image_name      = "vmseries-flex-bundle2-1126"


# ------------------------------------------------
# Optional
# ------------------------------------------------
subnet_cidr_mgmt = "10.0.0.0/28"
subnet_cidr_data = "10.0.1.0/28"
prefix           = "nsi"
csp_authcodes    = ""
csp_pin_id       = ""
csp_pin_value    = ""
max_firewalls    = 1
min_firewalls    = 1
mirroring_mode   = false

# Zonal affinity for the firewall load balancer. Keeps inspection traffic within the
# consumer's source zone. Options: ZONAL_AFFINITY_DISABLED, ZONAL_AFFINITY_STAY_WITHIN_ZONE,
# ZONAL_AFFINITY_SPILL_CROSS_ZONE. spillover_ratio (0.0-1.0) only applies to SPILL_CROSS_ZONE.
zonal_affinity_spillover       = "ZONAL_AFFINITY_SPILL_CROSS_ZONE"
zonal_affinity_spillover_ratio = 0.8